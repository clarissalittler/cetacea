-- Constructive first-order recurrence proofs over natural numbers.
import ../nat.ctea as N
mode constructive

-- The same initial value and update rule determine the same sequence.
theorem recurrence_unique (A : Type) (f g : Nat -> A) (step : Nat -> A -> A) :
  f(0) = g(0) ->
  (forall n : Nat, f(succ(n)) = step(n, f(n))) ->
  (forall n : Nat, g(succ(n)) = step(n, g(n))) ->
  forall n : Nat, f(n) = g(n) := by
  intro initial
  intro f_step
  intro g_step
  intro n
  induction n with
  | zero =>
      exact initial
  | succ k ih =>
      rewrite -> f_step k
      rewrite -> g_step k
      rewrite -> ih
      refl

-- An arithmetic progression: f(0)=a, f(n+1)=d+f(n).
theorem constant_step_closed (f : Nat -> Nat) (a d : Nat) :
  f(0) = a ->
  (forall n : Nat, f(succ(n)) = add(d, f(n))) ->
  forall n : Nat, f(n) = add(a, mul(n, d)) := by
  intro initial
  intro step
  intro n
  induction n with
  | zero =>
      simp
      exact initial
  | succ k ih =>
      rewrite -> step k
      rewrite -> ih
      rewrite -> N.mul_succ_left
      rewrite <- N.add_assoc {n := d; m := a; k := mul(k, d)}
      rewrite -> N.add_comm {n := d; m := a}
      rewrite -> N.add_assoc
      refl

-- The closed form satisfies the recurrence, so it can also be used as a
-- candidate solution in a uniqueness argument.
theorem constant_step_successor (a d n : Nat) :
  add(a, mul(succ(n), d)) = add(d, add(a, mul(n, d))) := by
  rewrite -> N.mul_succ_left
  rewrite <- N.add_assoc {n := a; m := d; k := mul(n, d)}
  rewrite -> N.add_comm {n := a; m := d}
  rewrite -> N.add_assoc
  refl
