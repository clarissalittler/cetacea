-- A finite table has the same total by rows or by columns.
import std/hol/matrix@1 as M
import weighted_sums.ctea as W
mode constructive

theorem columns_without_rows (A B : Type) (w : A -> B -> Nat) (ys : M.List B) :
  M.columns_total(w, M.nil, ys) = 0 := by
  induction ys with
  | nil =>
      exact M.columns_total_nil {A := A; B := B; w := w; xs := M.nil}
  | cons b tail ih =>
      rewrite -> M.columns_total_cons
      rewrite -> M.column_sum_nil
      rewrite -> ih
      simp
      refl

theorem columns_add_row (A B : Type) (w : A -> B -> Nat) (a : A) (xs : M.List A) (ys : M.List B) :
  M.columns_total(w, M.cons(a, xs), ys) = add(M.row_sum(w, a, ys), M.columns_total(w, xs, ys)) := by
  induction ys with
  | nil =>
      rewrite -> M.columns_total_nil
      rewrite -> M.row_sum_nil
      rewrite -> M.columns_total_nil
      simp
      refl
  | cons b tail ih =>
      rewrite -> M.columns_total_cons
      rewrite -> M.column_sum_cons
      rewrite -> ih
      rewrite -> M.row_sum_cons
      rewrite -> M.columns_total_cons
      exact W.add_interchange

theorem double_counting (A B : Type) (w : A -> B -> Nat) (xs : M.List A) (ys : M.List B) :
  M.rows_total(w, xs, ys) = M.columns_total(w, xs, ys) := by
  induction xs with
  | nil =>
      rewrite -> M.rows_total_nil
      rewrite -> columns_without_rows
      refl
  | cons a tail ih =>
      rewrite -> M.rows_total_cons
      rewrite -> columns_add_row
      rewrite -> ih
      refl
