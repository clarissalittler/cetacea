-- Integer numerators for finite, uniformly sampled lists of outcomes.
-- Division and probability measures are not primitives of this library.
import weighted_sums.ctea as W
import sums.ctea as S
import std/hol/cardinality@1 as C
import ../nat.ctea as N
mode constructive

-- A nonempty outcome list supplies a nonzero denominator.
theorem nonempty_denominator (A : Type) (x : A) (xs : C.List A) :
  not C.length(C.cons(x, xs)) = 0 := by
  rewrite -> C.length_cons
  intro zero_length
  contradiction

-- Complementary zero-one indicators contribute exactly one per occurrence.
theorem complement_counts (A : Type) (f g : A -> Nat) (xs : C.List A) :
  (forall x : A, C.Member(x, xs) -> add(f(x), g(x)) = 1) ->
  add(S.sum(C.map(f, xs)), S.sum(C.map(g, xs))) = C.length(xs) := by
  induction xs with
  | nil =>
      intro partition
      rewrite -> C.map_nil
      rewrite -> C.map_nil
      rewrite -> C.length_nil
      simp
      refl
  | cons x t ih =>
      intro partition
      have head_member : C.Member(x, C.cons(x, t)) := W.member_head
      have head : add(f(x), g(x)) = 1 := partition x head_member
      have on_tail : forall y : A, C.Member(y, t) -> add(f(y), g(y)) = 1 := by
        intro y
        intro member
        have in_list : C.Member(y, C.cons(x, t)) := W.member_tail {A := A; x := x; y := y; t := t} member
        exact partition y in_list
      have tail : add(S.sum(C.map(f, t)), S.sum(C.map(g, t))) = C.length(t) := ih on_tail
      rewrite -> C.map_cons
      rewrite -> C.map_cons
      rewrite -> S.sum_cons
      rewrite -> W.add_interchange
      rewrite -> head
      rewrite -> tail
      rewrite -> C.length_cons
      refl

-- Linearity of the numerator needs no independence premise.
theorem numerator_add (A : Type) (f g h : A -> Nat) (xs : C.List A) :
  (forall x : A, C.Member(x, xs) -> h(x) = add(f(x), g(x))) ->
  S.sum(C.map(h, xs)) = add(S.sum(C.map(f, xs)), S.sum(C.map(g, xs))) := by
  exact W.sum_map_add_on {A := A; f := f; g := g; h := h; xs := xs}

theorem constant_numerator (A : Type) (f : A -> Nat) (xs : C.List A) (k : Nat) :
  (forall x : A, C.Member(x, xs) -> f(x) = k) ->
  S.sum(C.map(f, xs)) = mul(C.length(xs), k) := by
  exact W.sum_map_constant_on {A := A; f := f; xs := xs; k := k}
