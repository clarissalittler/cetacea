-- Concrete modular multiplication: both congruence premises are checked.
import builtin:std/modular.ctea as M
mode constructive

theorem clock_27_3 : M.ModEq(12, 27, 3) := by
  unfold M.ModEq
  exists 0
  exists 2
  refl

theorem clock_squares : M.ModEq(12, mul(27, 27), mul(3, 3)) := by
  exact M.modeq_mul {m := 12; x := 27; y := 3; u := 27; v := 3} clock_27_3 clock_27_3
