-- Chapter 17 exercises. Replace each sorry with a proof.
-- Keep the theorem names and statements; helper theorems are welcome.
import builtin:std/hol/sums.ctea as S
import std/hol/list@1 as L
import builtin:std/nat.ctea as N

mode constructive

-- 17.1: Entries contribute once per occurrence, including repeated values.
theorem ex17_1 : S.sum(L.cons(3, L.cons(0, L.cons(3, L.nil)))) = 6 := by
  sorry

-- 17.2: Use a known total to account for one new entry.
theorem ex17_2 (xs : L.List Nat) (n : Nat) :
  S.sum(xs) = n -> S.sum(L.cons(4, xs)) = add(4, n) := by
  sorry

-- 17.3: Combine two groups whose totals are known.
theorem ex17_3 (xs ys : L.List Nat) (m n : Nat) :
  S.sum(xs) = m -> S.sum(ys) = n ->
  S.sum(L.append(xs, ys)) = add(m, n) := by
  sorry

-- 17.4: Combine three groups, then associate the numerical additions to the right.
theorem ex17_4 (xs ys zs : L.List Nat) :
  S.sum(L.append(L.append(xs, ys), zs)) =
  add(S.sum(xs), add(S.sum(ys), S.sum(zs))) := by
  sorry
