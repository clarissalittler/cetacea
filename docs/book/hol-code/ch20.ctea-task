  "source": "version = 1\nprofile = \"fol+induction\"\nallow_classical = false\nallow_extensionality = false\nallow_choice = false\nallow_new_axioms = false\nallow_incomplete = false\nallowed_imports = [\"builtin:std/modular.ctea\", \"builtin:std/nat.ctea\", \"builtin:std/eq.ctea\"]\nrequired_imports = [\"builtin:std/modular.ctea\"]\nallowed_axioms = []\n\nrequired_theorem.ex20_1 = 'M.Divides(4, 20)'\nrequired_theorem.ex20_2 = '(?0 : Nat) (?1 : Nat) (?2 : Nat) : M.Divides(?0, ?1) -> M.Divides(?0, ?2) -> M.Divides(?0, add(?1, mul(?2, 3)))'\nrequired_theorem.ex20_3 = '(?0 : Nat) (?1 : Nat) (?2 : Nat) : M.ModEq(?0, ?1, ?2) -> M.ModEq(?0, add(mul(?1, ?1), 1), add(mul(?2, ?2), 1))'\nrequired_theorem.ex20_4 = '(?0 : Nat) (?1 : Nat) : M.ModEq(0, ?0, ?1) -> ?0 = ?1'\n",
