  "source": "version = 1\nprofile = \"hol\"\nallow_classical = false\nallow_extensionality = false\nallow_choice = false\nallow_new_axioms = false\nallow_incomplete = false\nallowed_imports = [\"builtin:std/hol/probability_counts.ctea\", \"builtin:std/hol/weighted_sums.ctea\", \"builtin:std/hol/sums.ctea\", \"builtin:std/nat.ctea\", \"std/hol/cardinality@1\", \"std/hol/list@1\"]\nrequired_imports = [\"builtin:std/hol/probability_counts.ctea\"]\nallowed_axioms = []\n\nrequired_theorem.ex22_1 = '(?0 : Type) (?1 : ?0) (?2 : std/hol/list@1.List ?0) : not std/hol/list@1.length(std/hol/list@1.cons(?1, ?2)) = 0'\nrequired_theorem.ex22_2 = '(?0 : Type) (?1 : ?0 -> Nat) (?2 : ?0 -> Nat) (?3 : std/hol/list@1.List ?0) : (forall ?4 : ?0, std/hol/list@1.Member(?4, ?3) -> add(?1(?4), ?2(?4)) = 1) -> add(S.sum(std/hol/cardinality@1.map(?1, ?3)), S.sum(std/hol/cardinality@1.map(?2, ?3))) = std/hol/list@1.length(?3)'\nrequired_theorem.ex22_3 = '(?0 : Type) (?1 : ?0 -> Nat) (?2 : ?0 -> Nat) (?3 : ?0 -> Nat) (?4 : std/hol/list@1.List ?0) (?5 : Nat) (?6 : Nat) : (forall ?7 : ?0, std/hol/list@1.Member(?7, ?4) -> ?3(?7) = add(?1(?7), ?2(?7))) -> S.sum(std/hol/cardinality@1.map(?1, ?4)) = ?5 -> S.sum(std/hol/cardinality@1.map(?2, ?4)) = ?6 -> S.sum(std/hol/cardinality@1.map(?3, ?4)) = add(?5, ?6)'\nrequired_theorem.ex22_4 = '(?0 : Type) (?1 : ?0 -> Nat) (?2 : std/hol/list@1.List ?0) (?3 : Nat) : (forall ?4 : ?0, std/hol/list@1.Member(?4, ?2) -> ?1(?4) = ?3) -> S.sum(std/hol/cardinality@1.map(?1, ?2)) = mul(std/hol/list@1.length(?2), ?3)'\n",
