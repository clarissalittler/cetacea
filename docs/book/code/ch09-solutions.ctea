-- Proofs, Checked — Chapter 9: exercise solutions.
-- Spoilers! Try docs/book/code/ch09-exercises.ctea yourself first.
--
--   cargo run -p hol_cli -- --course courses/proofs-checked.json --section ch09 docs/book/code/ch09-solutions.ctea

import ../../../std/prelude.ctea

mode constructive

-- Exercise 9.1. Computation: 1 * n unfolds to n + 0 * n,
-- then to n + 0, then to n.
theorem ex9_1 (n : Nat) : 1 * n = n := by
  refl

-- Exercise 9.2
theorem ex9_2 (n : Nat) : n <= succ(n) := by
  induction n with
  | zero =>
      simp
      trivial
  | succ k ih =>
      simp
      exact ih

-- Exercise 9.3
theorem ex9_3 (n m : Nat) : (n + m) - n = m := by
  induction n with
  | zero =>
      refl
  | succ k ih =>
      simp
      exact ih

-- Exercise 9.4
theorem ex9_4 (n m : Nat) : n <= n + m := by
  induction n with
  | zero =>
      simp
      trivial
  | succ k ih =>
      simp
      exact ih

-- Exercise 9.5
theorem ex9_5 (k n m : Nat) : k + (n + m) = k + (m + n) := by
  rewrite -> add_comm {n := m; m := n}
  refl

-- Exercise 9.6
theorem ex9_6 (n m p : Nat) : (n + m) + p = n + (m + p) := by
  induction n with
  | zero =>
      simp
      refl
  | succ k ih =>
      simp
      rewrite <- ih
      refl
